# Shopy Store sample configuration — placeholders only, NEVER put real secrets in Git.
# In production configure values in Vercel project environment settings.
SECRET_KEY=
DATABASE_URL=

# Safka read-only integration (secrets go in Vercel, not here).
SHOPY_SAFKA_API_KEY=
SHOPY_SAFKA_READ_ENABLED=0
SHOPY_SAFKA_PRODUCTS_PATH=/api/v1/public/products
SHOPY_SAFKA_SHIPPING_PATH=/api/v1/public/price-list

# Set production flags to 1 to activate the customer-authorized automatic flow.
# Keep preview disabled; API credentials must stay server-side.
SHOPY_SAFKA_ORDER_PUSH_ACTIVE=0
SHOPY_SAFKA_TEST_SEND_ENABLED=0
SHOPY_SAFKA_ORDER_SCHEMA_VERIFIED=0
SHOPY_STAGING_OWNER_CHECKOUT=0
SHOPY_WA_ENABLED=0

# The commission is COD total minus supplier products minus supplier shipping.
# Product properties, city IDs and availability are verified on the server.
SHOPY_PUBLIC_CHECKOUT_ENABLED=0
SHOPY_SAFKA_COMMISSION_POLICY_VERIFIED=0
# Manual refresh every three days keeps listing data recent without faking stock.
SHOPY_SAFKA_MAX_STOCK_AGE_MINUTES=5760

# Public configuration for the Supabase PKCE social-login bridge.
# Provider client secrets belong in the Supabase provider dashboard, never here.
SHOPY_AUTH_SUPABASE_URL=
SHOPY_AUTH_PUBLISHABLE_KEY=
SHOPY_PUBLIC_URL=https://shoppy-store-one.vercel.app
SHOPY_AUTH_GOOGLE_ENABLED=0
# Apple login is intentionally disabled.


# Reviewed bundle-offer rollout: disabled until totals and Safka margins are verified.
SHOPY_BUNDLE_OFFER_ENABLED=0
# Amount discounted from the verified shipping fee for a one-item order.
# Owner sets this after checking real governorate tariffs (0 means no discount).
SHOPY_SINGLE_ITEM_SHIPPING_REDUCTION_EGP=0
# WhatsApp Cloud API secrets go only in Vercel environment settings.
SHOPY_WA_RECIPIENTS=
SHOPY_WA_ACCESS_TOKEN=
SHOPY_WA_PHONE_NUMBER_ID=
SHOPY_WA_GRAPH_VERSION=
SHOPY_WA_TEMPLATE_NAME=shopy_new_order_v1
SHOPY_WA_TEMPLATE_LANG=ar
